{
  "source": "GPPB Resolution No. 03-2025, dated 14 May 2025 (14 May 2025 GPPB meeting)",
  "note": "Classification is taken verbatim from the resolution: STANDARD = Strategic Planning Forms, PBD and PBD Related Forms, whose use is mandatory. RECOMMENDED = 'other forms', templates that are explicitly NOT classified as Standard Forms. The official form bodies are NOT bundled here: official_file_hash is null for every form, so the system fails closed and cannot emit a release-ready legal document until the official files are downloaded, hashed, and registered by a human.",
  "online_platform_caveat": "The resolution's proposed common revision (a) allows Standard Forms to be accomplished manually OR through online platforms 'as may be authorized by the GPPB'. Confirm agency authorization before treating any system-generated form as an accomplished form.",
  "forms": [
    {"code": "APP", "name": "Annual Procurement Plan", "classification": "STANDARD", "category": "Strategic Planning Forms", "applies_to": ["*"], "required_fields": ["pe_name", "fiscal_year", "approved_by", "approval_date"]},
    {"code": "PPMP", "name": "Project Procurement Management Plan", "classification": "STANDARD", "category": "Strategic Planning Forms", "applies_to": ["*"], "required_fields": ["end_user_unit", "fiscal_year", "item_description", "estimated_budget"]},
    {"code": "MMSF", "name": "Mandatory Market Scoping Form", "classification": "STANDARD", "category": "Strategic Planning Forms", "applies_to": ["*"], "required_fields": ["item_description", "cost_estimate", "technical_specifications", "delivery_schedule"]},

    {"code": "PBD_GOODS", "name": "Philippine Bidding Documents (Goods)", "classification": "STANDARD", "category": "PBD", "applies_to": ["Competitive Bidding", "Limited Source Bidding", "Competitive Dialogue", "Unsolicited Offer with Bid Matching"], "required_fields": ["project_title", "abc", "delivery_schedule", "bac_chair"]},
    {"code": "PBD_INFRA", "name": "Philippine Bidding Documents (Infrastructure Projects)", "classification": "STANDARD", "category": "PBD", "applies_to": ["Competitive Bidding", "Limited Source Bidding", "Competitive Dialogue", "Unsolicited Offer with Bid Matching"], "required_fields": ["project_title", "abc", "contract_duration", "bac_chair"]},
    {"code": "PBD_CONSULTING", "name": "Philippine Bidding Documents (Consulting Services)", "classification": "STANDARD", "category": "PBD", "applies_to": ["Competitive Bidding", "Limited Source Bidding", "Competitive Dialogue"], "required_fields": ["project_title", "abc", "tor_reference", "bac_chair"]},

    {"code": "CONTRACT_FORM", "name": "Contract Form", "classification": "STANDARD", "category": "PBD Related Forms", "applies_to": ["*"], "required_fields": ["contract_number", "supplier_name", "contract_amount", "hop_e_signature"]},
    {"code": "OSS", "name": "Omnibus Sworn Statement", "classification": "STANDARD", "category": "PBD Related Forms", "applies_to": ["*"], "required_fields": ["bidder_name", "authorized_representative", "notarized"]},
    {"code": "BSD", "name": "Bid Securing Declaration", "classification": "STANDARD", "category": "PBD Related Forms", "applies_to": ["*"], "required_fields": ["bidder_name", "project_title", "signed"]},
    {"code": "PSD", "name": "Performance Securing Declaration", "classification": "STANDARD", "category": "PBD Related Forms", "applies_to": ["*"], "required_fields": ["supplier_name", "contract_number", "signed"]},
