    {"code": "NOTICE_POST_QUAL", "name": "Notice of Post Qualification with Additional Requirements", "classification": "RECOMMENDED", "category": "Other forms", "applies_to": ["Competitive Bidding"], "required_fields": ["bidder_name", "requirements", "deadline"]},
    {"code": "OFFEROR_FORM_UNSOLICITED", "name": "Offeror Form for Submission of Unsolicited Offer", "classification": "RECOMMENDED", "category": "Other forms", "applies_to": ["Unsolicited Offer with Bid Matching"], "required_fields": ["offeror_name", "project_title"]},
