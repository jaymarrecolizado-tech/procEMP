    {"code": "PRICE_SCHEDULE", "name": "Price Schedule", "classification": "STANDARD", "category": "PBD Related Forms (Goods)", "applies_to": ["Competitive Bidding"], "required_fields": ["item_description", "quantity", "unit_price", "total_cost"]},
    {"code": "TECHNICAL_PROPOSAL", "name": "Technical Proposal Forms", "classification": "STANDARD", "category": "PBD Related Forms (Consulting)", "applies_to": ["Competitive Bidding"], "required_fields": ["consultant_name", "approach_methodology", "work_schedule", "staffing_schedule"]},
    {"code": "FINANCIAL_PROPOSAL", "name": "Financial Proposal Forms", "classification": "STANDARD", "category": "PBD Related Forms (Consulting)", "applies_to": ["Competitive Bidding"], "required_fields": ["consultant_name", "cost_breakdown", "total_amount"]},

    {"code": "RFQ_REI", "name": "Request for Quotation / Request for Expression of Interest", "classification": "RECOMMENDED", "category": "Other forms", "applies_to": ["Small Value Procurement", "Negotiated Procurement"], "required_fields": ["pr_number", "item_description", "abc", "submission_deadline"]},
