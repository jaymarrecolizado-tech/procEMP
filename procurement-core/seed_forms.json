    {"code": "BLACKLISTING_ORDER", "name": "Blacklisting Order", "classification": "RECOMMENDED", "category": "Other forms", "applies_to": ["*"], "required_fields": ["subject_name", "reason"]},
    {"code": "EARLY_PROCUREMENT_COMPLIANCE", "name": "Early Procurement Activity Compliance Form", "classification": "RECOMMENDED", "category": "Other forms", "applies_to": ["*"], "required_fields": ["fiscal_year", "pe_name"]},
    {"code": "OBSERVERS_REPORT", "name": "Observer's Report", "classification": "RECOMMENDED", "category": "Other forms", "applies_to": ["Competitive Bidding"], "required_fields": ["observer_name", "project_title", "meeting_date"]},
    {"code": "CAPACITY_DEVELOPMENT_REPORT", "name": "Capacity Development Report Form", "classification": "RECOMMENDED", "category": "Other forms", "applies_to": ["*"], "required_fields": ["reporting_period", "pe_name"]}
