    {"code": "REJECTION_UNSOLICITED_OFFER", "name": "Rejection Template for Unsolicited Offer", "classification": "RECOMMENDED", "category": "Other forms", "applies_to": ["Unsolicited Offer with Bid Matching"], "required_fields": ["offeror_name", "reason"]},
