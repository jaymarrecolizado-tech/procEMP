[Unit]
Description=ProcEMP review UI (loopback-only, behind reverse proxy)
After=network.target

[Service]
Type=simple
User=procemp
Group=procemp
WorkingDirectory=/opt/procemp/app/procurement-core
EnvironmentFile=/opt/procemp/etc/procemp.env
ExecStart=/usr/bin/python3 review_server.py --db /opt/procemp/data/procurement.db --drafts-dir /opt/procemp/data/drafts --auth-token ${REVIEW_AUTH_TOKEN} --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=3
# Hardening: app writes only under /opt/procemp/data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/procemp/data

[Install]
WantedBy=multi-user.target
